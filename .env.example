# ==============================================================================
# Oracle Cloud Personal AI Server - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN AND TLS CONFIGURATION
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to your Oracle VPS IP.
# If you don't have a custom domain yet, you can use nip.io or sslip.io:
# Example: AI_DOMAIN=203.0.113.195.nip.io (or your custom domain)
AI_DOMAIN=ai.example.com

# Contact email for ACME / Let's Encrypt expiry and certificate notifications
LETSENCRYPT_EMAIL=admin@example.com

# TLS Mode:
#   'auto'     - Public production TLS certificate via Let's Encrypt / ZeroSSL
#   'internal' - Caddy internal self-signed TLS (for IP-only, local VPN, or testing)
CADDY_TLS_MODE=auto

# ------------------------------------------------------------------------------
# 2. OPEN WEBUI SECURITY & SETTINGS
# ------------------------------------------------------------------------------
# Encryption key for securing web sessions and stored credentials.
# Automatically generated by scripts/deploy.sh or generate via: openssl rand -hex 32
WEBUI_SECRET_KEY=replace_with_a_secure_random_64_char_hex_key

# Public signup control:
#   'true'  - Allow registration (REQUIRED during first-time setup to create admin)
#   'false' - Block new registrations (Recommended after creating your admin account)
ENABLE_SIGNUP=true

# Default model presented when users open a new chat
DEFAULT_MODELS=qwen2.5:3b

# Open WebUI API / Web Search configuration (Optional)
# ENABLE_RAG_WEB_SEARCH=false
# SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json

# Document & RAG Embedding Settings
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=bge-m3
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# 3. OLLAMA CPU INFERENCE OPTIMIZATIONS (Ampere A1 4 OCPU / 24GB RAM)
# ------------------------------------------------------------------------------
# Number of parallel requests processed per model (1 recommended for CPU inference)
OLLAMA_NUM_PARALLEL=1

# Maximum models kept loaded simultaneously in memory
OLLAMA_MAX_LOADED_MODELS=1

# How long a model stays loaded in RAM after last request (e.g. 5m, 1h, 24h, -1 for infinite)
OLLAMA_KEEP_ALIVE=24h

# OpenMP execution threads (Match OCPU count for ARM64 CPU)
OMP_NUM_THREADS=4

# Default context window (in tokens, starting at 8192)
OLLAMA_CONTEXT_SIZE=8192

# ------------------------------------------------------------------------------
# 4. CONTAINER RESOURCE CONSTRAINTS (Docker Compose Limits)
# ------------------------------------------------------------------------------
# Safeguard VPS stability and prevent OOM killer on 24GB total RAM
OLLAMA_CPU_LIMIT=3.5
OLLAMA_MEM_LIMIT=16G
OLLAMA_MEM_RESERVATION=4G

WEBUI_CPU_LIMIT=1.5
WEBUI_MEM_LIMIT=4G
WEBUI_MEM_RESERVATION=1G

CADDY_CPU_LIMIT=0.5
CADDY_MEM_LIMIT=1G

# ------------------------------------------------------------------------------
# 5. DOCKER IMAGE RELEASES (Pinned for stability)
# ------------------------------------------------------------------------------
OLLAMA_IMAGE=ollama/ollama:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
CADDY_IMAGE=caddy:2.9-alpine

